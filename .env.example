# Host LAN IP: the address the device uses to reach the VPN.
# `./vpnburp up` autodetects it and rewrites this value on every start.
REMOTE_HOST=192.168.1.10

# Host interface the VPN port is published on (0.0.0.0 = all of them)
BIND_IP=0.0.0.0

# --- VPN ---
VPN_PORT=1194
VPN_PROTO=udp
VPN_NET=10.8.0.0
VPN_MASK=255.255.255.0
VPN_CIDR=10.8.0.0/24
VPN_DNS=1.1.1.1,1.0.0.1
CLIENT_NAME=iphone

# --- Burp (on the host) ---
# Empty BURP_HOST = the bridge gateway (172.28.0.1), i.e. the host.
BURP_HOST=
BURP_PORT=8080

# Client ports redirected to Burp. Add whichever ones the app uses
# (e.g. 8443,9443 for APIs on non-standard ports).
INTERCEPT_PORTS=80,443

# Block udp/443 so the app cannot escape over QUIC/HTTP3
BLOCK_QUIC=1

# MTU: traffic rides over VPN + TLS + WiFi; lowering this avoids fragmentation
MTU=1400
MSSFIX=1360
